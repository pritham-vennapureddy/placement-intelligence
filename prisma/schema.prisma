generator client {
  provider        = "prisma-client"
  output          = "../backend/src/generated/prisma"
  // Load relations with one joined SQL query instead of one query per relation;
  // each database round trip is costly from far-away regions.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

// Category a product belongs to. Assumed mapping: CCBP_ACADEMY_* -> ACADEMY,
// CCBP_INTENSIVE* and INTENSIVE_COLLEGE_PLUS -> ACADEMY_INTENSIVE, External -> EXTERNAL.
enum CandidateCategory {
  ACADEMY
  ACADEMY_INTENSIVE
  EXTERNAL
}

enum AssessedPoolStatus {
  YES
  NO
  UNKNOWN
}

enum ChangeSource {
  MANUAL
  IMPORT
  SYSTEM
  CARRIED_OVER
}

enum ApplicationStatus {
  ACTIVE
  WITHDRAWN
  CLOSED
}

// TA, RS, SC, AS, SP
enum InternalStage {
  TOTAL_APPLICATIONS
  RESUME_SHORTLIST
  SCREENING_SHORTLIST
  ASSIGNMENT_SHORTLIST
  FINAL_SHORTLIST
}

enum StageStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PARTIALLY_COMPLETED
  NOT_CONDUCTED
}

enum StageCandidateOutcome {
  PENDING
  SELECTED
  REJECTED
  ON_HOLD
  NO_SHOW
  WITHDRAWN
}

enum ScreeningPriority {
  P1
  P2
  P3
}

enum NominationStatus {
  NOMINATED
  WITHDRAWN
}

// Company-side lifecycle; keeps selected / offer released / accepted / joined distinct.
enum CompanyPipelineStatus {
  NOT_SUBMITTED
  IN_PROCESS
  ON_HOLD
  REJECTED
  SELECTED
  OFFER_RELEASED
  OFFER_ACCEPTED
  OFFER_DECLINED
  JOINED
  DROPPED
}

enum InterviewRoundType {
  RESUME_SCREENING
  ASSIGNMENT
  TECHNICAL
  MANAGERIAL
  HR
  CLIENT
  OTHER
}

enum InterviewOutcome {
  SCHEDULED
  CLEARED
  REJECTED
  ON_HOLD
  NO_SHOW
  CANCELLED
}

enum ImportSourceType {
  EXCEL
  CSV
  GOOGLE_SHEETS
}

enum ImportTarget {
  INTERNAL_SCREENING
  COMPANY_PIPELINE
}

enum ImportBatchStatus {
  UPLOADED
  VALIDATED
  COMMITTED
  CANCELLED
}

enum ValidationStatus {
  VALID
  WARNING
  INVALID
}

enum RecordApprovalStatus {
  INCLUDED
  EXCLUDED
}

enum StagingAction {
  CREATE
  UPDATE
  NO_CHANGE
  CONFLICT
  SKIP
}

enum IssueSeverity {
  ERROR
  WARNING
  INFO
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
}

enum JobRequestStatus {
  DRAFT
  OPEN
  ON_HOLD
  FILLED
  CANCELLED
  CLOSED
}

enum RecruitmentBatchStatus {
  ACTIVE
  CLOSED
}

enum SheetSourceType {
  INTERNAL_PROCESS
  COMPANY_PROCESS
  STUDENT_APPLICATIONS
  CANDIDATE_PROFILES
  ASSESSED_POOL
}

enum CandidatePoolType {
  BUCKET
  TR
  COMPETENCY
}

// Why the SC (screening) stage was skipped and profiles went to SP on other signals.
enum ScreeningSkipReason {
  TIME_CONSTRAINT
  COMPANY_REQUESTED_DIRECT
  REPEAT_DRIVE
  PRE_ASSESSED_PROFILES
  LOW_APPLICATIONS
  OTHER
}

// Where the company's hiring process stands for a job. Round phases point at one
// of the job's configured rounds (JobRequest.processRoundId).
enum CompanyProcessPhase {
  YET_TO_SHARE_CVS
  CVS_SHARED
  HIRING_IN_PROGRESS
  ROUND_YET_TO_START
  ROUND_IN_PROGRESS
  ON_HOLD
  OFFERS_RELEASED
  PROCESS_DONE_HIRED
  PROCESS_DONE_NOT_HIRED
}

// Per-student tasks on the Guidance & RSA page. RSA = rejection section analysis.
enum StudentSupportKind {
  GUIDANCE
  RSA
}

enum AssessedProcessType {
  OLD
  NEW
  UNKNOWN
}

model User {
  id                     String                      @id @default(uuid()) @db.Uuid
  email                  String                      @unique
  fullName               String
  passwordHash           String
  isActive               Boolean                     @default(true)
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  roles                  UserRole[]
  refreshTokens          RefreshToken[]
  createdCompanies       Company[]                   @relation("CompanyCreator")
  ownedJobRequests       JobRequest[]                @relation("JobRequestOwner")
  createdJobRequests     JobRequest[]                @relation("JobRequestCreator")
  assignmentsReceived    PSMAssignment[]             @relation("AssignmentOwner")
  assignmentsCreated     PSMAssignment[]             @relation("AssignmentCreator")
  auditLogs              AuditLog[]
  teamId                 String?                     @db.Uuid
  team                   Team?                       @relation("TeamMembers", fields: [teamId], references: [id], onDelete: SetNull)
  ledTeam                Team?                       @relation("TeamLead")
  teamsCreated           Team[]                      @relation("TeamCreator")
  sheetConnections       SheetConnection[]           @relation("SheetConnectionCreator")
  idempotencyKeys        IdempotencyKey[]
  stageOwnership         InternalProcessStage[]      @relation("StageOwner")
  stageDecisions         InternalStageCandidate[]    @relation("StageDecisionMaker")
  stageCompletions       StageCompletionRecord[]     @relation("StageCompletionRecorder")
  nominationsCreated     CompanyNomination[]         @relation("NominationCreator")
  companyStageChanges    CompanyStageHistory[]       @relation("CompanyStageChanger")
  importBatches          ImportBatch[]               @relation("ImportBatchCreator")
  importApprovals        ImportApproval[]            @relation("ImportApprover")
  assessedPoolImports    AssessedPoolImport[]        @relation("AssessedPoolImportCreator")
  assessedPoolSources    AssessedPoolSource[]        @relation("AssessedPoolSourceCreator")
  processPhaseChanges    CompanyProcessHistory[]     @relation("CompanyProcessChanger")
  guidanceSessions       GuidanceSession[]           @relation("GuidanceGiver")
  guidanceRecorded       GuidanceSession[]           @relation("GuidanceRecorder")
  supportContributions   StudentSupportContributor[]
  supportUpdates         StudentSupport[]            @relation("StudentSupportUpdater")
  supportStatusesCreated SupportStatusOption[]       @relation("SupportStatusCreator")
}

model Role {
  id          String     @id @default(uuid()) @db.Uuid
  code        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  users       UserRole[]
}

model Team {
  id               String            @id @default(uuid()) @db.Uuid
  name             String            @unique
  createdById      String            @db.Uuid
  teamLeadId       String?           @unique @db.Uuid
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        User              @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Restrict)
  teamLead         User?             @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  members          User[]            @relation("TeamMembers")
  sheetConnections SheetConnection[]

  @@index([createdById, createdAt])
}

model SheetConnection {
  id              String                    @id @default(uuid()) @db.Uuid
  spreadsheetId   String
  title           String
  sourceType      SheetSourceType
  teamId          String?                   @db.Uuid
  createdById     String                    @db.Uuid
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  team            Team?                     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy       User                      @relation("SheetConnectionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  tabMappings     SheetTabMapping[]
  poolMemberships CandidatePoolMembership[]

  @@unique([spreadsheetId, sourceType])
  @@index([teamId, sourceType])
}

model SheetTabMapping {
  id            String          @id @default(uuid()) @db.Uuid
  connectionId  String          @db.Uuid
  workflowStage String
  sheetId       Int
  sheetTitle    String
  headerRow     Int
  columnMapping Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  connection    SheetConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, workflowStage])
  @@index([connectionId, sheetId])
}

model CandidatePoolMembership {
  id                 String            @id @default(uuid()) @db.Uuid
  candidateCode      String
  candidateId        String?           @db.Uuid
  poolType           CandidatePoolType
  sourceConnectionId String            @db.Uuid
  updatedAt          DateTime          @updatedAt
  candidate          Candidate?        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  sourceConnection   SheetConnection   @relation(fields: [sourceConnectionId], references: [id], onDelete: Cascade)

  @@unique([candidateCode, poolType, sourceConnectionId])
  @@index([candidateId, poolType])
  @@index([sourceConnectionId, poolType])
}

model AssessedPoolImport {
  id             String               @id @default(uuid()) @db.Uuid
  sourceFileName String
  sourceSheet    String
  rowCount       Int
  importedCount  Int
  updatedCount   Int
  skippedCount   Int
  mapping        Json
  rawRows        Json                 @default("[]")
  importedById   String               @db.Uuid
  createdAt      DateTime             @default(now())
  importedBy     User                 @relation("AssessedPoolImportCreator", fields: [importedById], references: [id], onDelete: Restrict)
  records        AssessedPoolRecord[]

  @@index([createdAt])
  @@index([importedById, createdAt])
}

/// The Google Sheet the assessed pool is kept in. One source per workspace; each sync re-reads it.
model AssessedPoolSource {
  id               String    @id @default(uuid()) @db.Uuid
  spreadsheetId    String
  spreadsheetUrl   String
  spreadsheetTitle String
  sheetTitle       String
  sheetTitles      Json      @default("[]")
  mapping          Json
  lastSyncedAt     DateTime?
  connectedById    String    @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  connectedBy      User      @relation("AssessedPoolSourceCreator", fields: [connectedById], references: [id], onDelete: Restrict)
}

model AssessedPoolRecord {
  id                     String              @id @default(uuid()) @db.Uuid
  mobile                 String              @unique
  sourceUserId           String?
  sourceName             String?
  processType            AssessedProcessType @default(UNKNOWN)
  isCompetencyPoolMember Boolean             @default(false)
  competencyLevel        String?
  category               CandidateCategory?
  bucketTier             String?
  tr1Status              String?
  tr2Status              String?
  competencyStatus       String?
  spReason               String?
  sourceData             Json                @default("{}")
  sourceImportId         String              @db.Uuid
  updatedAt              DateTime            @updatedAt
  sourceImport           AssessedPoolImport  @relation(fields: [sourceImportId], references: [id], onDelete: Restrict)

  @@index([sourceName])
  @@index([sourceUserId])
  @@index([category])
  @@index([bucketTier])
  @@index([sourceImportId])
}

model UserRole {
  userId String @db.Uuid
  roleId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  familyId  String    @db.Uuid
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([familyId])
}

model Company {
  id               String        @id @default(uuid()) @db.Uuid
  // Entered manually for now; filled from HubSpot later. Name is not a key.
  hubspotCompanyId String?       @unique
  name             String
  status           CompanyStatus @default(ACTIVE)
  notes            String?
  website          String?
  industry         String?
  location         String?
  archivedAt       DateTime?
  createdById      String        @db.Uuid
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  createdBy        User          @relation("CompanyCreator", fields: [createdById], references: [id], onDelete: Restrict)
  jobRequests      JobRequest[]

  @@index([name])
  @@index([status, createdAt])
}

model Skill {
  id             String            @id @default(uuid()) @db.Uuid
  name           String
  normalizedName String            @unique
  createdAt      DateTime          @default(now())
  jobRequests    JobRequestSkill[]
  candidates     CandidateSkill[]
}

// Candidate programmes (e.g. CCBP_ACADEMY_SMART). Applicants to one job come
// from many products, so products attach to candidates and applications; a job
// may list the products eligible to apply.
model Product {
  id           String              @id @default(uuid()) @db.Uuid
  code         String              @unique
  name         String              @unique
  category     CandidateCategory
  description  String?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  eligibleFor  JobRequestProduct[]
  candidates   CandidateProduct[]
  applications Application[]
}

model JobRequest {
  id                     String                       @id @default(uuid()) @db.Uuid
  // Job ID generated in HubSpot (a UUID); the PSM copies it in. Internal-sheet
  // application exports carry the same value, so imports match on it.
  jobId                  String                       @unique
  // HubSpot deal record (object 0-3) the job belongs to.
  hubspotDealId          String?                      @unique
  companyId              String                       @db.Uuid
  roleTitle              String
  openings               Int
  requiredCandidateCount Int                          @default(1)
  // Offered CTC in lakhs per annum (upper bound when the company gives a range).
  // Drives the < 8 LPA placement KPIs; null means not entered yet.
  ctcLpa                 Float?
  description            String
  psmOwnerId             String?                      @db.Uuid
  requestDate            DateTime                     @db.Date
  deadline               DateTime?                    @db.Date
  status                 JobRequestStatus             @default(DRAFT)
  timeline               String?
  shortlistingMechanism  String?
  companyRemarks         String?
  companySheetUrl        String?
  internalSheetUrl       String?
  // Company process status, set by a PSM (see CompanyProcessPhase).
  processPhase           CompanyProcessPhase          @default(YET_TO_SHARE_CVS)
  processRoundId         String?                      @db.Uuid
  processPhaseAt         DateTime?
  archivedAt             DateTime?
  createdById            String                       @db.Uuid
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  company                Company                      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  psmOwner               User?                        @relation("JobRequestOwner", fields: [psmOwnerId], references: [id], onDelete: SetNull)
  createdBy              User                         @relation("JobRequestCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments            PSMAssignment[]
  skills                 JobRequestSkill[]
  eligibleProducts       JobRequestProduct[]
  applications           Application[]
  recruitmentBatches     RecruitmentBatch[]
  internalProcess        InternalProcess?
  interviewRounds        CompanyInterviewRound[]
  importBatches          ImportBatch[]
  resumeAssessments      CandidateResumeAssessment[]
  additionalProfiles     CandidateAdditionalProfile[]
  processRound           CompanyInterviewRound?       @relation("JobProcessRound", fields: [processRoundId], references: [id], onDelete: SetNull)
  processHistory         CompanyProcessHistory[]
  guidanceSessions       GuidanceSession[]
  studentSupport         StudentSupport[]

  @@index([companyId, status])
  @@index([psmOwnerId, status])
  @@index([deadline, status])
}

/// A distinct hiring cycle inside a stable company/job request. Each cycle can
/// use the same workbook with different tabs or a separate read-only workbook.
model RecruitmentBatch {
  id                 String                       @id @default(uuid()) @db.Uuid
  jobRequestId       String                       @db.Uuid
  name               String
  sequence           Int
  status             RecruitmentBatchStatus       @default(ACTIVE)
  openings           Int?
  startsAt           DateTime?                    @db.Date
  endsAt             DateTime?                    @db.Date
  // Null means "use the job request's sheet"; set only when this batch lives in a different workbook.
  internalSheetUrl   String?
  companySheetUrl    String?
  // Tabs of the internal sheet that belong to this batch, chosen by the PSM: { TA, RS, SC, AS, SP } → tab name.
  internalTabs       Json?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  jobRequest         JobRequest                   @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  applications       Application[]
  importBatches      ImportBatch[]
  interviewRounds    CompanyInterviewRound[]
  resumeAssessments  CandidateResumeAssessment[]
  additionalProfiles CandidateAdditionalProfile[]

  @@unique([jobRequestId, sequence])
  @@unique([jobRequestId, name])
  @@index([jobRequestId, status, sequence])
}

model JobRequestSkill {
  jobRequestId String     @db.Uuid
  skillId      String     @db.Uuid
  isMandatory  Boolean    @default(true)
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([jobRequestId, skillId])
  @@index([skillId])
}

model JobRequestProduct {
  jobRequestId String     @db.Uuid
  productId    String     @db.Uuid
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([jobRequestId, productId])
  @@index([productId])
}

// Ownership is per job request. One row per (re)assignment; `endedAt` closes the
// previous one. The migration adds a partial unique index allowing one open row per job.
model PSMAssignment {
  id           String     @id @default(uuid()) @db.Uuid
  jobRequestId String     @db.Uuid
  assignedToId String     @db.Uuid
  assignedById String?    @db.Uuid
  assignedAt   DateTime   @default(now())
  endedAt      DateTime?
  notes        String?
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Restrict)
  assignedTo   User       @relation("AssignmentOwner", fields: [assignedToId], references: [id], onDelete: Restrict)
  assignedBy   User?      @relation("AssignmentCreator", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([jobRequestId, endedAt])
  @@index([assignedToId, endedAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String
  metadata   Json?
  requestId  String?
  ipAddress  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

// Duplicate-request protection for mutating calls that send an Idempotency-Key header.
model IdempotencyKey {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  key            String
  method         String
  path           String
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([expiresAt])
}

// ───────────────────────── Candidates & applications ─────────────────────────

model Candidate {
  id                 String                       @id @default(uuid()) @db.Uuid
  // Platform user ID where known; otherwise generated ("GEN-…") when a sheet has none.
  candidateCode      String                       @unique
  fullName           String
  // PII. Not unique: source data shares emails/mobiles across user IDs, so
  // likely duplicates are flagged for review instead of blocked.
  email              String?
  mobile             String? // digits only, 10-digit Indian numbers without +91
  gender             String?
  currentCity        String?
  state              String?
  college            String?
  degree             String?
  department         String?
  graduationYear     Int?
  academicScore      Decimal?                     @db.Decimal(5, 2)
  resumeUrl          String?
  category           CandidateCategory?
  assessedPool       AssessedPoolStatus           @default(UNKNOWN)
  archivedAt         DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  products           CandidateProduct[]
  skills             CandidateSkill[]
  applications       Application[]
  poolMemberships    CandidatePoolMembership[]
  resumeAssessments  CandidateResumeAssessment[]
  additionalProfiles CandidateAdditionalProfile[]

  @@index([email])
  @@index([mobile])
  @@index([fullName])
  @@index([category])
}

model CandidateProduct {
  candidateId String    @db.Uuid
  productId   String    @db.Uuid
  firstSeenAt DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@id([candidateId, productId])
  @@index([productId])
}

model CandidateSkill {
  candidateId String    @db.Uuid
  skillId     String    @db.Uuid
  createdAt   DateTime  @default(now())
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Restrict)

  @@id([candidateId, skillId])
  @@index([skillId])
}

// One candidate in one job request; every job keeps its own history.
model Application {
  id                  String                   @id @default(uuid()) @db.Uuid
  candidateId         String                   @db.Uuid
  jobRequestId        String                   @db.Uuid
  recruitmentBatchId  String                   @db.Uuid
  productId           String?                  @db.Uuid // candidate's product when they applied
  status              ApplicationStatus        @default(ACTIVE)
  appliedAt           DateTime                 @default(now())
  source              ChangeSource             @default(MANUAL)
  importBatchId       String?                  @db.Uuid
  // Set when the PSM re-uses the candidate from an earlier drive.
  sourceApplicationId String?                  @db.Uuid
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  candidate           Candidate                @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  jobRequest          JobRequest               @relation(fields: [jobRequestId], references: [id], onDelete: Restrict)
  recruitmentBatch    RecruitmentBatch         @relation(fields: [recruitmentBatchId], references: [id], onDelete: Restrict)
  product             Product?                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  importBatch         ImportBatch?             @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  sourceApplication   Application?             @relation("CarriedOver", fields: [sourceApplicationId], references: [id], onDelete: SetNull)
  carriedInto         Application[]            @relation("CarriedOver")
  stageOutcomes       InternalStageCandidate[]
  nomination          CompanyNomination?
  support             StudentSupport[]

  @@unique([candidateId, jobRequestId, recruitmentBatchId])
  @@unique([id, jobRequestId])
  @@index([jobRequestId, status])
  @@index([productId])
}

// ─────────────────────────── Internal PSM screening ───────────────────────────

model InternalProcess {
  id                String                 @id @default(uuid()) @db.Uuid
  jobRequestId      String                 @unique @db.Uuid
  // How the PSM shortlisted for this job (criteria, tests used, …).
  shortlistingNotes String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  jobRequest        JobRequest             @relation(fields: [jobRequestId], references: [id], onDelete: Restrict)
  stages            InternalProcessStage[]

  @@unique([id, jobRequestId])
}

// Status is only ever set explicitly by a person; never inferred from data.
model InternalProcessStage {
  id              String                   @id @default(uuid()) @db.Uuid
  processId       String                   @db.Uuid
  jobRequestId    String                   @db.Uuid
  stage           InternalStage
  status          StageStatus              @default(NOT_STARTED)
  ownerId         String?                  @db.Uuid
  completedAt     DateTime?
  nextPlannedDate DateTime?                @db.Date
  remarks         String?
  // Set with NOT_CONDUCTED on SC; `remarks` holds the required note.
  skipReason      ScreeningSkipReason?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  process         InternalProcess          @relation(fields: [processId, jobRequestId], references: [id, jobRequestId], onDelete: Restrict)
  owner           User?                    @relation("StageOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  candidates      InternalStageCandidate[]
  completionLog   StageCompletionRecord[]

  @@unique([processId, stage])
  @@unique([id, jobRequestId])
}

// A candidate's outcome at one stage. The composite foreign keys guarantee the
// application and the stage belong to the same job request.
model InternalStageCandidate {
  id              String                @id @default(uuid()) @db.Uuid
  stageId         String                @db.Uuid
  applicationId   String                @db.Uuid
  jobRequestId    String                @db.Uuid
  outcome         StageCandidateOutcome @default(PENDING)
  priority        ScreeningPriority?
  techScore       Decimal?              @db.Decimal(4, 1)
  commScore       Decimal?              @db.Decimal(4, 1)
  rejectionReason String?
  remarks         String?
  selectionBasis  String?
  source          ChangeSource          @default(MANUAL)
  importBatchId   String?               @db.Uuid
  decidedById     String?               @db.Uuid
  decidedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  stage           InternalProcessStage  @relation(fields: [stageId, jobRequestId], references: [id, jobRequestId], onDelete: Restrict)
  application     Application           @relation(fields: [applicationId, jobRequestId], references: [id, jobRequestId], onDelete: Restrict)
  importBatch     ImportBatch?          @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  decidedBy       User?                 @relation("StageDecisionMaker", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([stageId, applicationId])
  @@index([applicationId])
  @@index([stageId, outcome])
}

// Resume analysis and extra candidate profile classifications are independent
// of recruitment stage outcomes, so they never affect funnel counts.
model CandidateResumeAssessment {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateId        String           @db.Uuid
  jobRequestId       String           @db.Uuid
  recruitmentBatchId String           @db.Uuid
  importBatchId      String?          @db.Uuid
  analyzedAt         DateTime?
  scores             Json
  skills             Json
  projects           Json
  details            Json
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  candidate          Candidate        @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  jobRequest         JobRequest       @relation(fields: [jobRequestId], references: [id], onDelete: Restrict)
  recruitmentBatch   RecruitmentBatch @relation(fields: [recruitmentBatchId], references: [id], onDelete: Restrict)
  importBatch        ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: Restrict)

  @@unique([candidateId, jobRequestId, recruitmentBatchId])
  @@index([jobRequestId, analyzedAt])
}

model CandidateAdditionalProfile {
  id                 String           @id @default(uuid()) @db.Uuid
  candidateId        String           @db.Uuid
  jobRequestId       String           @db.Uuid
  recruitmentBatchId String           @db.Uuid
  importBatchId      String?          @db.Uuid
  classification     String
  sourceSheet        String
  data               Json
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  candidate          Candidate        @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  jobRequest         JobRequest       @relation(fields: [jobRequestId], references: [id], onDelete: Restrict)
  recruitmentBatch   RecruitmentBatch @relation(fields: [recruitmentBatchId], references: [id], onDelete: Restrict)
  importBatch        ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: Restrict)

  @@unique([candidateId, jobRequestId, recruitmentBatchId, classification, sourceSheet])
  @@index([jobRequestId, classification])
}

// Append-only log of explicit stage status changes.
model StageCompletionRecord {
  id           String               @id @default(uuid()) @db.Uuid
  stageId      String               @db.Uuid
  fromStatus   StageStatus
  toStatus     StageStatus
  remarks      String?
  recordedById String?              @db.Uuid
  recordedAt   DateTime             @default(now())
  stage        InternalProcessStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  recordedBy   User?                @relation("StageCompletionRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@index([stageId, recordedAt])
}

// ─────────────────────────── Company hiring pipeline ───────────────────────────

// The only link between internal screening and the company pipeline. Created by
// the PSM; internally rejected candidates cannot be nominated.
model CompanyNomination {
  id              String                @id @default(uuid()) @db.Uuid
  applicationId   String                @unique @db.Uuid
  jobRequestId    String                @db.Uuid
  status          NominationStatus      @default(NOMINATED)
  pipelineStatus  CompanyPipelineStatus @default(NOT_SUBMITTED)
  source          ChangeSource          @default(MANUAL)
  nominatedById   String                @db.Uuid
  submittedAt     DateTime?
  offerReleasedAt DateTime?
  offerAcceptedAt DateTime?
  joinedAt        DateTime?
  remarks         String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  application     Application           @relation(fields: [applicationId, jobRequestId], references: [id, jobRequestId], onDelete: Restrict)
  nominatedBy     User                  @relation("NominationCreator", fields: [nominatedById], references: [id], onDelete: Restrict)
  interviews      CompanyInterview[]
  stageHistory    CompanyStageHistory[]

  @@unique([id, jobRequestId])
  @@unique([applicationId, jobRequestId])
  @@index([jobRequestId, pipelineStatus])
}

// Rounds are configured per job request; no fixed number.
model CompanyInterviewRound {
  id                 String                  @id @default(uuid()) @db.Uuid
  jobRequestId       String                  @db.Uuid
  recruitmentBatchId String                  @db.Uuid
  name               String
  roundType          InterviewRoundType      @default(OTHER)
  sequence           Int
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  jobRequest         JobRequest              @relation(fields: [jobRequestId], references: [id], onDelete: Restrict)
  recruitmentBatch   RecruitmentBatch        @relation(fields: [recruitmentBatchId], references: [id], onDelete: Restrict)
  interviews         CompanyInterview[]
  currentForJobs     JobRequest[]            @relation("JobProcessRound")
  processHistory     CompanyProcessHistory[]

  @@unique([jobRequestId, recruitmentBatchId, name])
  @@unique([id, jobRequestId])
  @@index([jobRequestId, sequence])
}

model CompanyInterview {
  id              String                @id @default(uuid()) @db.Uuid
  nominationId    String                @db.Uuid
  roundId         String                @db.Uuid
  jobRequestId    String                @db.Uuid
  outcome         InterviewOutcome      @default(SCHEDULED)
  scheduledAt     DateTime?
  interviewerName String?
  feedback        String?
  rejectionReason String?
  source          ChangeSource          @default(MANUAL)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  nomination      CompanyNomination     @relation(fields: [nominationId, jobRequestId], references: [id, jobRequestId], onDelete: Restrict)
  round           CompanyInterviewRound @relation(fields: [roundId, jobRequestId], references: [id, jobRequestId], onDelete: Restrict)

  @@unique([nominationId, roundId])
  @@index([roundId, outcome])
}

// Append-only history of pipeline status changes.
model CompanyStageHistory {
  id           String                 @id @default(uuid()) @db.Uuid
  nominationId String                 @db.Uuid
  fromStatus   CompanyPipelineStatus?
  toStatus     CompanyPipelineStatus
  notes        String?
  source       ChangeSource           @default(MANUAL)
  changedById  String?                @db.Uuid
  changedAt    DateTime               @default(now())
  nomination   CompanyNomination      @relation(fields: [nominationId], references: [id], onDelete: Restrict)
  changedBy    User?                  @relation("CompanyStageChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([nominationId, changedAt])
  @@index([toStatus, changedAt])
}

// Append-only log of company process status changes for a job.
model CompanyProcessHistory {
  id           String                 @id @default(uuid()) @db.Uuid
  jobRequestId String                 @db.Uuid
  fromPhase    CompanyProcessPhase?
  toPhase      CompanyProcessPhase
  roundId      String?                @db.Uuid
  // Round name at the time, kept if the round is renamed or removed.
  roundName    String?
  notes        String?
  changedById  String?                @db.Uuid
  changedAt    DateTime               @default(now())
  jobRequest   JobRequest             @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  round        CompanyInterviewRound? @relation(fields: [roundId], references: [id], onDelete: SetNull)
  changedBy    User?                  @relation("CompanyProcessChanger", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([jobRequestId, changedAt])
}

// ─────────────────────────────── Guidance ───────────────────────────────

// Interview guidance given for a whole job drive. Any PSM may record a session
// they gave, including on another PSM's job; several sessions are allowed.
model GuidanceSession {
  id           String     @id @default(uuid()) @db.Uuid
  jobRequestId String     @db.Uuid
  givenById    String     @db.Uuid
  givenOn      DateTime   @db.Date
  notes        String?
  recordedById String     @db.Uuid
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  jobRequest   JobRequest @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  givenBy      User       @relation("GuidanceGiver", fields: [givenById], references: [id], onDelete: Restrict)
  recordedBy   User       @relation("GuidanceRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([jobRequestId, givenOn])
  @@index([givenById, givenOn])
}

// Guidance or RSA for one student on one job: a status plus everyone who
// contributed. Names of people without an account go in otherContributors.
model StudentSupport {
  id                String                      @id @default(uuid()) @db.Uuid
  applicationId     String                      @db.Uuid
  jobRequestId      String                      @db.Uuid
  kind              StudentSupportKind
  statusId          String                      @db.Uuid
  doneOn            DateTime?                   @db.Date
  otherContributors String?
  notes             String?
  updatedById       String?                     @db.Uuid
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  application       Application                 @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status            SupportStatusOption         @relation(fields: [statusId], references: [id], onDelete: Restrict)
  jobRequest        JobRequest                  @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  updatedBy         User?                       @relation("StudentSupportUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  contributors      StudentSupportContributor[]

  @@unique([applicationId, kind])
  @@index([jobRequestId, kind, statusId])
  @@index([statusId])
}

// The team-managed status list for Guidance and for RSA. Deleting a status that
// students already have archives it, so their records keep the label.
model SupportStatusOption {
  id               String             @id @default(uuid()) @db.Uuid
  kind             StudentSupportKind
  label            String
  // Colour key from SUPPORT_TONES in @placement/shared.
  tone             String             @default("slate")
  // Counted as "done" in My work and job summaries.
  countsAsDone     Boolean            @default(false)
  needsContributor Boolean            @default(false)
  needsNote        Boolean            @default(false)
  sortOrder        Int                @default(0)
  archivedAt       DateTime?
  createdById      String?            @db.Uuid
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  createdBy        User?              @relation("SupportStatusCreator", fields: [createdById], references: [id], onDelete: SetNull)
  supports         StudentSupport[]

  @@index([kind, archivedAt, sortOrder])
}

model StudentSupportContributor {
  supportId String         @db.Uuid
  userId    String         @db.Uuid
  support   StudentSupport @relation(fields: [supportId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([supportId, userId])
  @@index([userId])
}

// ──────────────────────────────── Imports ────────────────────────────────

// One source read for a job and target. Structured snapshot rows support review and revalidation.
model ImportBatch {
  id                  String                       @id @default(uuid()) @db.Uuid
  batchCode           String                       @unique
  target              ImportTarget
  sourceType          ImportSourceType
  status              ImportBatchStatus            @default(UPLOADED)
  jobRequestId        String                       @db.Uuid
  recruitmentBatchId  String                       @db.Uuid
  sourceFileName      String
  // Google Sheets imports: the spreadsheet read, so the PSM can refresh from it.
  sourceSpreadsheetId String?
  sourceUrl           String?
  sourceChecksum      String
  snapshotSize        Int
  sourceSnapshot      Json?
  sheets              Json // [{ name, rowCount, columnCount }]
  mapping             Json? // the PSM's choices, reused for the next upload
  summary             Json? // validation counts shown during review
  importedById        String                       @db.Uuid
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  committedAt         DateTime?
  jobRequest          JobRequest                   @relation(fields: [jobRequestId], references: [id], onDelete: Restrict)
  recruitmentBatch    RecruitmentBatch             @relation(fields: [recruitmentBatchId], references: [id], onDelete: Restrict)
  importedBy          User                         @relation("ImportBatchCreator", fields: [importedById], references: [id], onDelete: Restrict)
  sheetMappings       ImportSheetMapping[]
  stagingRecords      ImportStagingRecord[]
  issues              DataQualityIssue[]
  approvals           ImportApproval[]
  applications        Application[]
  stageOutcomes       InternalStageCandidate[]
  resumeAssessments   CandidateResumeAssessment[]
  additionalProfiles  CandidateAdditionalProfile[]

  @@index([jobRequestId, createdAt])
  @@index([sourceChecksum])
}

model ImportSheetMapping {
  id            String                @id @default(uuid()) @db.Uuid
  batchId       String                @db.Uuid
  role          String // APPLICATIONS, PRODUCTS, a stage code, or COMPANY_TAB
  worksheetName String
  headerRow     Int
  columnMapping Json
  createdAt     DateTime              @default(now())
  batch         ImportBatch           @relation(fields: [batchId], references: [id], onDelete: Cascade)
  records       ImportStagingRecord[]

  @@unique([batchId, role, worksheetName])
}

model ImportStagingRecord {
  id                String               @id @default(uuid()) @db.Uuid
  batchId           String               @db.Uuid
  sheetMappingId    String               @db.Uuid
  sourceRowNumber   Int
  sourceRowRef      String?
  rawData           Json
  normalizedData    Json
  validationStatus  ValidationStatus
  approvalStatus    RecordApprovalStatus @default(INCLUDED)
  action            StagingAction
  matchedEntityType String?
  matchedEntityId   String?              @db.Uuid
  committedAt       DateTime?
  batch             ImportBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sheetMapping      ImportSheetMapping   @relation(fields: [sheetMappingId], references: [id], onDelete: Cascade)
  issues            DataQualityIssue[]

  @@unique([sheetMappingId, sourceRowNumber])
  @@index([batchId, validationStatus])
}

model DataQualityIssue {
  id              String               @id @default(uuid()) @db.Uuid
  batchId         String               @db.Uuid
  stagingRecordId String?              @db.Uuid
  severity        IssueSeverity
  code            String
  message         String
  createdAt       DateTime             @default(now())
  batch           ImportBatch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  stagingRecord   ImportStagingRecord? @relation(fields: [stagingRecordId], references: [id], onDelete: Cascade)

  @@index([batchId, severity])
  @@index([stagingRecordId])
}

model ImportApproval {
  id          String      @id @default(uuid()) @db.Uuid
  batchId     String      @db.Uuid
  decision    String // APPROVED or CANCELLED
  notes       String?
  counts      Json?
  decidedById String      @db.Uuid
  decidedAt   DateTime    @default(now())
  batch       ImportBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  decidedBy   User        @relation("ImportApprover", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([batchId])
}
