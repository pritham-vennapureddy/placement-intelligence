NODE_ENV=development
PORT=3001

# `neon env pull` fills DATABASE_URL and DATABASE_URL_UNPOOLED for the linked branch.
# DATABASE_URL is pooled app traffic; DATABASE_URL_UNPOOLED is preferred for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/DB?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB?sslmode=require

# Generate distinct random values of at least 32 characters for local use.
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=use-a-different-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

FRONTEND_ORIGIN=http://localhost:5173

# These are provided by `neon env pull` when the corresponding services are enabled.
# Keep them server-side; never expose storage credentials or the Realtime secret to Vite.
# NEON_REALTIME_URL=
# NEON_REALTIME_SECRET=
# NEON_FUNCTION_HELLO_BASE_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=
# GOOGLE_SERVICE_ACCOUNT_BASE64=

# Used only by the explicit prisma db seed command.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
ADMIN_NAME=Platform Administrator
